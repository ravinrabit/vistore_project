# Copie para .env e ajuste. O .env nunca vai para o Git.
# Gere a chave com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-por-uma-chave-gerada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MariaDB portátil (porta 3309, root sem senha) — ver CLAUDE.md
DB_NAME=vistore
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3309

# E-mail: no desenvolvimento os alertas aparecem no terminal do runserver.
# Para enviar de verdade, troque pelo backend SMTP e preencha o servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario@exemplo.com
# EMAIL_HOST_PASSWORD=senha-do-email
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Vistore <nao-responda@vistore.test>
SITE_URL=http://localhost:8000
